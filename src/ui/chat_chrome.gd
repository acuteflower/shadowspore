class_name ChatChrome
extends RefCounted
## Pixel-art sprite atlas & drawing helpers for Shadowspore's Whisper Vine Chat.
## Reads regions from `assets/ui/chat_chrome.png` (generated by `tools/art_chat_chrome.py`).
## Strictly nearest-filtered, pixel-snapped, zero-stretch 1:1 surface tiling.

const SHEET_PATH: String = "res://assets/ui/chat_chrome.png"

# 9-slice frames
const REG_CARD: Rect2 = Rect2(4, 4, 24, 24)
const REG_INPUT: Rect2 = Rect2(32, 4, 20, 16)
const REG_SUGGEST: Rect2 = Rect2(56, 4, 20, 20)
const REG_TAB_IDLE: Rect2 = Rect2(80, 4, 24, 16)
const REG_TAB_ACTIVE: Rect2 = Rect2(108, 4, 24, 16)

# Corner vine clasps (12x12)
const REG_CORNER_NW: Rect2 = Rect2(136, 4, 12, 12)
const REG_CORNER_NE: Rect2 = Rect2(152, 4, 12, 12)
const REG_CORNER_SW: Rect2 = Rect2(168, 4, 12, 12)
const REG_CORNER_SE: Rect2 = Rect2(184, 4, 12, 12)

# Sliding bloom & scrollbar strips
const REG_BLOOM: Rect2 = Rect2(200, 4, 24, 7)
const REG_SCROLL_RAIL: Rect2 = Rect2(228, 4, 5, 16)
const REG_SCROLL_THUMB_IDLE: Rect2 = Rect2(236, 4, 5, 14)
const REG_SCROLL_THUMB_LIT: Rect2 = Rect2(244, 4, 5, 14)

# Seamless 1:1 tiles
const TILE_VELLUM_DAY: Rect2 = Rect2(4, 72, 48, 48)
const TILE_VELLUM_NIGHT: Rect2 = Rect2(56, 72, 48, 48)
const TILE_INPUT_WELL: Rect2 = Rect2(108, 72, 32, 16)

const ICON_INDEX: Dictionary = {
	"game": 0,
	"group": 1,
	"direct": 2,
	"plus": 3,
	"send": 4,
	"expand": 5,
	"close": 6,
	"pin": 7,
	"bud": 8,
}

static var _sheet: Texture2D = null
static var _scroll_styles: Dictionary = {}


static func sheet() -> Texture2D:
	if _sheet == null and ResourceLoader.exists(SHEET_PATH):
		_sheet = load(SHEET_PATH) as Texture2D
	return _sheet


static func draw_nine_slice(canvas: CanvasItem, dest: Rect2, src: Rect2, ml: float, mt: float, mr: float, mb: float, tint: Color = Color.WHITE) -> void:
	var tex: Texture2D = sheet()
	if tex == null or dest.size.x < 2.0 or dest.size.y < 2.0:
		return
	var r: Rect2 = Rect2(dest.position.round(), dest.size.round())
	var l: float = minf(ml, floorf(r.size.x * 0.5))
	var ri: float = minf(mr, floorf(r.size.x * 0.5))
	var t: float = minf(mt, floorf(r.size.y * 0.5))
	var b: float = minf(mb, floorf(r.size.y * 0.5))
	var mw: float = maxf(r.size.x - l - ri, 0.0)
	var mh: float = maxf(r.size.y - t - b, 0.0)
	var smw: float = maxf(src.size.x - ml - mr, 1.0)
	var smh: float = maxf(src.size.y - mt - mb, 1.0)
	var sx: float = src.position.x
	var sy: float = src.position.y
	var dx: float = r.position.x
	var dy: float = r.position.y

	canvas.draw_texture_rect_region(tex, Rect2(dx, dy, l, t), Rect2(sx, sy, ml, mt), tint)
	canvas.draw_texture_rect_region(tex, Rect2(dx + l + mw, dy, ri, t), Rect2(sx + ml + smw, sy, mr, mt), tint)
	canvas.draw_texture_rect_region(tex, Rect2(dx, dy + t + mh, l, b), Rect2(sx, sy + mt + smh, ml, mb), tint)
	canvas.draw_texture_rect_region(tex, Rect2(dx + l + mw, dy + t + mh, ri, b), Rect2(sx + ml + smw, sy + mt + smh, mr, mb), tint)
	if mw > 0.0:
		canvas.draw_texture_rect_region(tex, Rect2(dx + l, dy, mw, t), Rect2(sx + ml, sy, smw, mt), tint)
		canvas.draw_texture_rect_region(tex, Rect2(dx + l, dy + t + mh, mw, b), Rect2(sx + ml, sy + mt + smh, smw, mb), tint)
	if mh > 0.0:
		canvas.draw_texture_rect_region(tex, Rect2(dx, dy + t, l, mh), Rect2(sx, sy + mt, ml, smh), tint)
		canvas.draw_texture_rect_region(tex, Rect2(dx + l + mw, dy + t, ri, mh), Rect2(sx + ml + smw, sy + mt, mr, smh), tint)
	if mw > 0.0 and mh > 0.0:
		canvas.draw_texture_rect_region(tex, Rect2(dx + l, dy + t, mw, mh), Rect2(sx + ml, sy + mt, smw, smh), tint)


static func draw_tiled_region(canvas: CanvasItem, dest: Rect2, tile_src: Rect2, tint: Color = Color.WHITE) -> void:
	var tex: Texture2D = sheet()
	if tex == null or dest.size.x <= 0.0 or dest.size.y <= 0.0:
		return
	var r: Rect2 = Rect2(dest.position.round(), dest.size.round())
	var tw: float = maxf(tile_src.size.x, 1.0)
	var th: float = maxf(tile_src.size.y, 1.0)
	var y: float = 0.0
	while y < r.size.y:
		var ch: float = minf(th, r.size.y - y)
		var x: float = 0.0
		while x < r.size.x:
			var cw: float = minf(tw, r.size.x - x)
			canvas.draw_texture_rect_region(
				tex,
				Rect2(r.position.x + x, r.position.y + y, cw, ch),
				Rect2(tile_src.position.x, tile_src.position.y, cw, ch),
				tint
			)
			x += tw
		y += th


static func draw_vellum_body(canvas: CanvasItem, rect: Rect2, alpha: float, night: float, accent: Color) -> void:
	var r: Rect2 = Rect2(rect.position.round(), rect.size.round())
	if r.size.x < 16.0 or r.size.y < 16.0 or alpha <= 0.01:
		return
	var w: int = int(r.size.x)
	var h: int = int(r.size.y)
	var fill_col: Color = Color("130e24").lerp(Color("0a0616"), night)
	var rim_top: Color = VineStyle.BARK_LIGHT.lerp(VineStyle.BARK_VOID_LIGHT, night)
	var rim_bot: Color = rim_top.darkened(0.38)
	var ink: Color = Color("0b0716", 0.92 * alpha)

	# 1. Soft organic ragged bark-paper silhouette (matches VineStyle.paper & HintCard, zero sharp box corners!)
	var prev_top: int = 0
	var prev_bot: int = h
	for x: int in range(0, w, 2):
		var col_w: int = mini(2, w - x)
		var d: int = mini(x, w - 1 - x)
		var notch: int = maxi(5 - d, 0)
		var jitter_t: int = int(VineStyle.rand(x / 3 + 17) * 2.2)
		var jitter_b: int = int(VineStyle.rand(x / 3 + 113) * 2.2)
		var top: int = notch + jitter_t
		var bot: int = h - notch - jitter_b
		if bot <= top + 2:
			continue
		# Subtle grounded shadow under the bottom organic edge
		canvas.draw_rect(Rect2(r.position.x + x, r.position.y + bot, col_w, 2.0), Color("070410", 0.34 * alpha))
		# Dark vellum silhouette base
		canvas.draw_rect(Rect2(r.position.x + x, r.position.y + top, col_w, bot - top), Color(fill_col, 0.84 * alpha))
		# Organic top edge with dark ink outline + lit bark catchlight
		var t_step: int = mini(top, prev_top) if x > 0 else top
		var t_span: int = (absi(top - prev_top) + 1) if x > 0 else 1
		canvas.draw_rect(Rect2(r.position.x + x, r.position.y + t_step - 1, col_w, 1.0), ink)
		canvas.draw_rect(Rect2(r.position.x + x, r.position.y + t_step, col_w, t_span), Color(rim_top, 0.90 * alpha))
		canvas.draw_rect(Rect2(r.position.x + x, r.position.y + top + 1, col_w, 1.0), Color(accent.lerp(rim_top, 0.55), 0.34 * alpha))
		# Organic bottom edge with shadowed bark rim + ink outline
		var b_step: int = mini(bot, prev_bot) - 1 if x > 0 else bot - 1
		var b_span: int = (absi(bot - prev_bot) + 1) if x > 0 else 1
		canvas.draw_rect(Rect2(r.position.x + x, r.position.y + b_step, col_w, b_span), Color(rim_bot, 0.86 * alpha))
		canvas.draw_rect(Rect2(r.position.x + x, r.position.y + bot, col_w, 1.0), ink)
		if x == 0 or x + col_w >= w:
			canvas.draw_rect(Rect2(r.position.x + x, r.position.y + top, 1.0, bot - top), Color(rim_top if x == 0 else rim_bot, 0.85 * alpha))
		prev_top = top
		prev_bot = bot

	# 2. True 1:1 tiled bark-vellum pixel texture tucked cleanly inside the organic contour
	var inner: Rect2 = Rect2(r.position + Vector2(5.0, 5.0), r.size - Vector2(10.0, 10.0))
	if inner.size.x > 4.0 and inner.size.y > 4.0:
		var tile: Rect2 = TILE_VELLUM_NIGHT if night > 0.5 else TILE_VELLUM_DAY
		draw_tiled_region(canvas, inner, tile, Color(1.0, 1.0, 1.0, 0.72 * alpha))
		# Subtle channel luminescence bleeding softly in from the left vine root
		canvas.draw_rect(Rect2(inner.position.x, inner.position.y, 2.0, inner.size.y), Color(accent, 0.14 * alpha))
		canvas.draw_rect(Rect2(inner.position.x + 2.0, inner.position.y, 3.0, inner.size.y), Color(accent, 0.06 * alpha))


static func draw_input_well(canvas: CanvasItem, rect: Rect2, alpha: float, focused: bool, accent: Color, shimmer_t: float) -> void:
	var r: Rect2 = Rect2(rect.position.round(), rect.size.round())
	if r.size.x < 8.0 or r.size.y < 8.0 or alpha <= 0.01:
		return
	var inner: Rect2 = r.grow(-2.0)
	if inner.size.x > 2.0 and inner.size.y > 2.0:
		draw_tiled_region(canvas, inner, TILE_INPUT_WELL, Color(1.0, 1.0, 1.0, 0.90 * alpha))
	draw_nine_slice(canvas, r, REG_INPUT, 5.0, 4.0, 5.0, 4.0, Color(1.0, 1.0, 1.0, 0.88 * alpha))
	if focused:
		# Delicate channel-colored organic glow along the recessed bottom seam
		var pulse: float = 0.42 + 0.24 * sin(shimmer_t * 3.0)
		canvas.draw_rect(Rect2(r.position.x + 4.0, r.end.y - 2.0, r.size.x - 8.0, 1.0), Color(accent, pulse * alpha))
		canvas.draw_rect(Rect2(r.position.x + 2.0, r.position.y + 3.0, 1.0, r.size.y - 6.0), Color(accent, 0.35 * pulse * alpha))
		var span: float = maxf(r.size.x - 20.0, 4.0)
		var gx: float = roundf(r.position.x + 10.0 + fposmod(shimmer_t * 24.0, span))
		canvas.draw_rect(Rect2(gx, r.end.y - 2.0, 5.0, 1.0), Color(accent.lightened(0.45), 0.65 * alpha))


static func draw_suggest_leaf(canvas: CanvasItem, rect: Rect2, alpha: float, night: float) -> void:
	var r: Rect2 = Rect2(rect.position.round(), rect.size.round())
	if r.size.x < 10.0 or r.size.y < 10.0 or alpha <= 0.01:
		return
	canvas.draw_rect(Rect2(r.position + Vector2(2.0, 2.0), r.size), Color("070410", 0.48 * alpha))
	var inner: Rect2 = r.grow(-2.0)
	if inner.size.x > 2.0 and inner.size.y > 2.0:
		var tile: Rect2 = TILE_VELLUM_NIGHT if night > 0.5 else TILE_VELLUM_DAY
		draw_tiled_region(canvas, inner, tile, Color(1.0, 1.0, 1.0, 0.96 * alpha))
	draw_nine_slice(canvas, r, REG_SUGGEST, 5.0, 5.0, 5.0, 5.0, Color(1.0, 1.0, 1.0, alpha))


static func draw_tab_pill(canvas: CanvasItem, rect: Rect2, active: bool, hover_t: float, accent: Color, alpha: float) -> void:
	var r: Rect2 = Rect2(rect.position.round(), rect.size.round())
	var src: Rect2 = REG_TAB_ACTIVE if active else REG_TAB_IDLE
	var boost: float = 1.0 + hover_t * 0.14
	draw_nine_slice(canvas, r, src, 5.0, 4.0, 5.0, 4.0, Color(boost, boost, boost, (0.96 if active else 0.84) * alpha))
	if active:
		canvas.draw_rect(Rect2(r.position.x + 3.0, r.position.y + 1.0, r.size.x - 6.0, 1.0), Color(accent, 0.78 * alpha))
		canvas.draw_rect(Rect2(r.position.x + 2.0, r.position.y + 2.0, r.size.x - 4.0, r.size.y - 4.0), Color(accent, 0.08 * alpha))
	elif hover_t > 0.05:
		canvas.draw_rect(Rect2(r.position.x + 3.0, r.position.y + 1.0, r.size.x - 6.0, 1.0), Color(accent, 0.42 * hover_t * alpha))


static func draw_corners(canvas: CanvasItem, rect: Rect2, alpha: float, night: float) -> void:
	var tex: Texture2D = sheet()
	if tex == null or alpha <= 0.01:
		return
	var r: Rect2 = Rect2(rect.position.round(), rect.size.round())
	var tint: Color = Color(1.0, 1.0, 1.0, alpha).lerp(Color("c4b4f0", alpha), night * 0.35)
	canvas.draw_texture_rect_region(tex, Rect2(r.position + Vector2(-2.0, -2.0), Vector2(12, 12)), REG_CORNER_NW, tint)
	canvas.draw_texture_rect_region(tex, Rect2(Vector2(r.end.x - 10.0, r.position.y - 2.0), Vector2(12, 12)), REG_CORNER_NE, tint)
	canvas.draw_texture_rect_region(tex, Rect2(Vector2(r.position.x - 2.0, r.end.y - 10.0), Vector2(12, 12)), REG_CORNER_SW, tint)
	canvas.draw_texture_rect_region(tex, Rect2(Vector2(r.end.x - 10.0, r.end.y - 10.0), Vector2(12, 12)), REG_CORNER_SE, tint)


static func draw_icon(canvas: CanvasItem, kind: String, pos: Vector2, lit: bool, alpha: float = 1.0, tint: Color = Color.WHITE) -> void:
	var tex: Texture2D = sheet()
	if tex == null or alpha <= 0.01:
		return
	var idx: int = int(ICON_INDEX.get(kind, 0))
	var reg: Rect2 = Rect2(4.0 + float(idx) * 16.0, 52.0 if lit else 36.0, 11.0, 11.0)
	canvas.draw_texture_rect_region(tex, Rect2(pos.round(), Vector2(11, 11)), reg, Color(tint.r, tint.g, tint.b, tint.a * alpha))


static func draw_bloom(canvas: CanvasItem, center_x: float, y: float, accent: Color, alpha: float) -> void:
	var tex: Texture2D = sheet()
	if tex == null or alpha <= 0.01:
		return
	var pos: Vector2 = Vector2(roundf(center_x - 12.0), roundf(y))
	canvas.draw_texture_rect_region(tex, Rect2(pos, Vector2(24, 7)), REG_BLOOM, Color(accent.r, accent.g, accent.b, alpha))


static func scroll_style(kind: String) -> StyleBoxTexture:
	if _scroll_styles.has(kind):
		return _scroll_styles[kind] as StyleBoxTexture
	var tex: Texture2D = sheet()
	var style: StyleBoxTexture = StyleBoxTexture.new()
	if tex != null:
		var atlas: AtlasTexture = AtlasTexture.new()
		atlas.atlas = tex
		if kind == "rail":
			atlas.region = REG_SCROLL_RAIL
			style.texture_margin_left = 1.0
			style.texture_margin_right = 1.0
			style.texture_margin_top = 2.0
			style.texture_margin_bottom = 2.0
		else:
			atlas.region = REG_SCROLL_THUMB_LIT if kind == "lit" else REG_SCROLL_THUMB_IDLE
			style.texture_margin_left = 1.0
			style.texture_margin_right = 1.0
			style.texture_margin_top = 3.0
			style.texture_margin_bottom = 3.0
		style.texture = atlas
	_scroll_styles[kind] = style
	return style
