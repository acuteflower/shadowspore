static var _font: FontFile = null


static func bitmap_font() -> FontFile:
	if _font != null:
		return _font
	var keys: Array = GLYPHS.keys()
	var total_w: int = 2
	var offsets_x: Array[int] = []
	var widths: Array[int] = []
	for k: Variant in keys:
		var rows: Array = GLYPHS[k] as Array
		var gw: int = String(rows[0]).length()
		offsets_x.append(total_w)
		widths.append(gw)
		total_w += gw + 1

	var atlas: Image = Image.create(maxi(total_w, 8), SIZE, false, Image.FORMAT_RGBA8)
	atlas.fill(Color(0, 0, 0, 0))

	_font = FontFile.new()
	_font.fixed_size = SIZE
	_font.fixed_size_scale_mode = TextServer.FIXED_SIZE_SCALE_INTEGER_ONLY
	_font.antialiasing = TextServer.FONT_ANTIALIASING_NONE
	_font.subpixel_positioning = TextServer.SUBPIXEL_POSITIONING_DISABLED
	_font.generate_mipmaps = false

	var cache: Vector2i = Vector2i(SIZE, 0)
	_font.set_cache_ascent(0, SIZE, float(ASCENT))
	_font.set_cache_descent(0, SIZE, float(DESCENT))

	# Space glyph
	var sp: int = " ".unicode_at(0)
	_font.set_glyph_advance(0, SIZE, sp, Vector2(SPACE_ADVANCE, 0))
	_font.set_glyph_offset(0, cache, sp, Vector2.ZERO)
	_font.set_glyph_size(0, cache, sp, Vector2.ZERO)
	_font.set_glyph_uv_rect(0, cache, sp, Rect2(0, 0, 0, 0))
	_font.set_glyph_texture_idx(0, cache, sp, 0)

	# Non-breaking space
	var nbsp: int = 160
	_font.set_glyph_advance(0, SIZE, nbsp, Vector2(SPACE_ADVANCE, 0))
	_font.set_glyph_offset(0, cache, nbsp, Vector2.ZERO)
	_font.set_glyph_size(0, cache, nbsp, Vector2.ZERO)
	_font.set_glyph_uv_rect(0, cache, nbsp, Rect2(0, 0, 0, 0))
	_font.set_glyph_texture_idx(0, cache, nbsp, 0)

	for i: int in keys.size():
		var ch: String = String(keys[i])
		var rows: Array = GLYPHS[ch] as Array
		var ox: int = offsets_x[i]
		var gw: int = widths[i]
		for row_idx: int in mini(rows.size(), SIZE):
			var row_str: String = String(rows[row_idx])
			for col_idx: int in mini(row_str.length(), gw):
				if row_str[col_idx] == "#":
					atlas.set_pixel(ox + col_idx, row_idx, Color.WHITE)
		var glyph: int = ch.unicode_at(0)
		_font.set_glyph_advance(0, SIZE, glyph, Vector2(gw + 1, 0))
		_font.set_glyph_offset(0, cache, glyph, Vector2(0, -ASCENT))
		_font.set_glyph_size(0, cache, glyph, Vector2(gw, SIZE))
		_font.set_glyph_uv_rect(0, cache, glyph, Rect2(ox, 0, gw, SIZE))
		_font.set_glyph_texture_idx(0, cache, glyph, 0)

	_font.set_texture_image(0, cache, 0, atlas)
	return _font


static func measure_width(text: String) -> float:
	if text.is_empty():
		return 0.0
	return bitmap_font().get_string_size(text, HORIZONTAL_ALIGNMENT_LEFT, -1, SIZE).x


## Draws crisp pixel-snapped text onto `canvas` with top-left at `pos` and an obsidian ink shadow/outline.
static func draw_ink(canvas: CanvasItem, text: String, pos: Vector2, color: Color, outline: Color = Color("0e091a", 0.85), full_outline: bool = false) -> void:
	if text.is_empty() or color.a <= 0.01:
		return
	var f: FontFile = bitmap_font()
	var base: Vector2 = Vector2(roundf(pos.x), roundf(pos.y) + float(ASCENT))
	if outline.a > 0.01:
		if full_outline:
			for off: Vector2 in [Vector2(-1, 0), Vector2(1, 0), Vector2(0, -1), Vector2(0, 1), Vector2(1, 1)]:
				f.draw_string(canvas.get_canvas_item(), base + off, text, HORIZONTAL_ALIGNMENT_LEFT, -1, SIZE, outline)
		else:
			f.draw_string(canvas.get_canvas_item(), base + Vector2(1, 1), text, HORIZONTAL_ALIGNMENT_LEFT, -1, SIZE, outline)
			f.draw_string(canvas.get_canvas_item(), base + Vector2(0, 1), text, HORIZONTAL_ALIGNMENT_LEFT, -1, SIZE, Color(outline, outline.a * 0.65))
	f.draw_string(canvas.get_canvas_item(), base, text, HORIZONTAL_ALIGNMENT_LEFT, -1, SIZE, color)


## Wraps `text` into pixel-accurate lines that fit inside `max_w`.
static func wrap_lines(text: String, max_w: float) -> PackedStringArray:
	var out: PackedStringArray = PackedStringArray()
	if text.is_empty() or max_w <= 12.0:
		return out
	var words: PackedStringArray = text.split(" ", false)
	var line: String = ""
	for word: String in words:
		var candidate: String = word if line.is_empty() else (line + " " + word)
		if measure_width(candidate) <= max_w:
			line = candidate
		else:
			if not line.is_empty():
				out.append(line)
				line = ""
			if measure_width(word) <= max_w:
				line = word
			else:
				# Hard-break an overly long token so it never overflows the panel
				var chunk: String = ""
				for ch: String in word:
					if measure_width(chunk + ch) > max_w and not chunk.is_empty():
						out.append(chunk)
						chunk = ch
					else:
						chunk += ch
				line = chunk
	if not line.is_empty():
		out.append(line)
	return out
