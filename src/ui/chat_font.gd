class_name ChatFont
extends RefCounted
## Crisp proportional mixed-case pixel bitmap font for Shadowspore's Whisper Vine Chat.
## Built specifically for the 640x360 pixel grid (1 font pixel = 1 game pixel):
##   - CELL_H = 11 px (ascent 9 px, descent 2 px)
##   - Uppercase cap height 7 px (rows 2..8), lowercase x-height 5 px (rows 4..8),
##     clean 2 px descenders (rows 9..10) and non-colliding German umlauts (äöüÄÖÜß).
## Works both in Godot Controls (LineEdit, RichTextLabel, Label) and direct CanvasItem drawing.

const SIZE: int = 11
const ASCENT: int = 9
const DESCENT: int = 2
const LINE_HEIGHT: int = 12
const SPACE_ADVANCE: int = 3

