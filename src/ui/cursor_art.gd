class_name CursorArt
extends RefCounted
## Pixel art of the game's own mouse cursor (`GameCursor`, src/autoload/game_cursor.gd). The glyphs are small
## ASCII maps that are baked into textures at run time, so one set of maps gives day, dusk and night (the body
## turns lilac-violet, the gold accent turns void violet) and every accent (teal, red, magenta, gold).
##
## The maps between the markers are generated by `python3 tools/art_cursor.py` (design the glyphs there, it also
## writes the contact sheet docs/img/cursor.png). Slots in a map:
##   # + -   petal white, lilac, deep lilac (the body)      g h   leaf, leaf light
##   k c C   accent dark, mid, light                        .     transparent
## The 1 px outline is added around every glyph when it is baked, never drawn by hand.

const NIGHT_STEPS: int = 8 ## the day-night blend is baked in this many steps (textures are cached)
const NEIGHBORS: Array[Vector2i] = [Vector2i(1, 0), Vector2i(-1, 0), Vector2i(0, 1), Vector2i(0, -1)]

const DAY: Dictionary = {
	"#": Color("f1e6ff"), "+": Color("bdb3e4"), "-": Color("8f84c2"),
	"g": Color("55985f"), "h": Color("a8dc8c"),
	"k": Color("b48a38"), "c": Color("e6c468"), "C": Color("fff0b0"),
	"x": Color("120c1c"), ## the outline
}
const NIGHT: Dictionary = {
	"#": Color("d8c4ff"), "+": Color("9468ee"), "-": Color("6636ad"),
	"g": Color("6a35c8"), "h": Color("c9a0ff"),
	"k": Color("6636ad"), "c": Color("9b5cff"), "C": Color("ecd2ff"),
	"x": Color("07040d"),
}
const ACCENTS: Dictionary = {
	&"teal": {"k": Color("2a8c94"), "c": Color("3cc0c6"), "C": Color("d0fff8")}, ## life, glow, water
	&"red": {"k": Color("8a1230"), "c": Color("ff4a63"), "C": Color("ffd0d6")}, ## danger, forbidden
	&"magenta": {"k": Color("7a1b78"), "c": Color("ff4fd8"), "C": Color("ffd6f6")}, ## the shadow creatures
	&"gold": {"k": Color("b48a38"), "c": Color("e6c468"), "C": Color("fff0b0")}, ## value, a bite
}


## A baked glyph: its texture and where the mouse position lies in it (the outline's margin included).
class Glyph extends RefCounted:
	var texture: ImageTexture
	var hot: Vector2i = Vector2i.ZERO
	var size: Vector2i = Vector2i.ZERO


static var _cache: Dictionary = {}


## The glyph `glyph_name` for a time of day (`night` 0..1) with an accent (&"" = gold by day, void violet by night).
static func glyph(glyph_name: StringName, night: float, accent: StringName = &"") -> Glyph:
	var step: int = roundi(clampf(night, 0.0, 1.0) * float(NIGHT_STEPS))
	var key: String = "%s|%d|%s" % [glyph_name, step, accent]
	if _cache.has(key):
		return _cache[key] as Glyph
	var baked: Glyph = _bake(glyph_name, float(step) / float(NIGHT_STEPS), accent)
	_cache[key] = baked
	return baked


static func _bake(glyph_name: StringName, night: float, accent: StringName) -> Glyph:
	var spec: Dictionary = GLYPHS[glyph_name] as Dictionary
	var rows: Array = spec["rows"] as Array
	var hot: Vector2i = spec["hot"]
	var palette: Dictionary = {}
	for slot: String in DAY:
		palette[slot] = (DAY[slot] as Color).lerp(NIGHT[slot] as Color, night)
	if accent != &"" and ACCENTS.has(accent):
		var tones: Dictionary = ACCENTS[accent] as Dictionary
		for slot: String in tones:
			palette[slot] = tones[slot]
	var height: int = rows.size()
	var width: int = 0
	for line: String in rows:
		width = maxi(width, line.length())
	var w: int = width + 2 ## one pixel of margin all around for the outline
	var h: int = height + 2
	var solid: PackedByteArray = PackedByteArray()
	solid.resize(w * h)
	var image: Image = Image.create_empty(w, h, false, Image.FORMAT_RGBA8)
	for y: int in height:
		var text: String = rows[y]
		for x: int in text.length():
			var cell: String = text[x]
			if palette.has(cell):
				image.set_pixel(x + 1, y + 1, palette[cell] as Color)
				solid[(y + 1) * w + x + 1] = 1
	var outline: Color = palette["x"] as Color
	for y: int in h:
		for x: int in w:
			if solid[y * w + x] == 1:
				continue
			for d: Vector2i in NEIGHBORS:
				var nx: int = x + d.x
				var ny: int = y + d.y
				if nx >= 0 and ny >= 0 and nx < w and ny < h and solid[ny * w + nx] == 1:
					image.set_pixel(x, y, outline)
					break
	var baked: Glyph = Glyph.new()
	baked.texture = ImageTexture.create_from_image(image)
	baked.hot = hot + Vector2i.ONE
	baked.size = Vector2i(w, h)
	return baked


