class_name MenuChrome
extends RefCounted
## Shared pixel-art 9-slice, 1:1 tiled surface, emblem, and animated FX renderer for Shadowspore's Feldcodex.
## Reads regions from `assets/ui/menu_chrome.png` (generated by `tools/art_menu_chrome.py`).
## Strictly nearest-filtered, pixel-snapped, zero-stretch tiled interiors, and statically typed.

const SHEET_PATH: String = "res://assets/ui/menu_chrome.png"

const REG_SLATE: Rect2 = Rect2(4, 4, 24, 24)
const REG_INSET: Rect2 = Rect2(32, 4, 24, 24)
const REG_PARCHMENT: Rect2 = Rect2(60, 4, 24, 24)
const REG_GOLD: Rect2 = Rect2(88, 4, 24, 24)
const REG_PILL_IDLE: Rect2 = Rect2(116, 4, 32, 22)
const REG_PILL_ACTIVE: Rect2 = Rect2(152, 4, 32, 22)
const REG_MOSS_NICHE: Rect2 = Rect2(188, 4, 28, 28)
const REG_BLOOM: Rect2 = Rect2(220, 4, 28, 8)
const REG_BADGE: Rect2 = Rect2(220, 16, 9, 9)
const REG_LOCK: Rect2 = Rect2(234, 16, 12, 12)

const REG_CANOPY: Rect2 = Rect2(4, 36, 48, 34)
const REG_FOOTER: Rect2 = Rect2(56, 36, 48, 20)
const REG_DIVIDER: Rect2 = Rect2(56, 60, 48, 7)
const REG_CORNER_NW: Rect2 = Rect2(110, 36, 14, 14)
const REG_CORNER_NE: Rect2 = Rect2(128, 36, 14, 14)
const REG_CORNER_SW: Rect2 = Rect2(146, 36, 14, 14)
const REG_CORNER_SE: Rect2 = Rect2(164, 36, 14, 14)

# Seamless 1:1 pixel-art surface tiles (NEVER stretched!)
const TILE_SLATE: Rect2 = Rect2(4, 116, 48, 48)
const TILE_INSET: Rect2 = Rect2(56, 116, 48, 48)
const TILE_COSMOS: Rect2 = Rect2(108, 116, 48, 48)
const TILE_VELLUM: Rect2 = Rect2(160, 116, 48, 48)
const TILE_CANOPY: Rect2 = Rect2(4, 170, 64, 34)
const TILE_FOOTER: Rect2 = Rect2(72, 170, 64, 20)

# Hand-crafted emblems & micro-icons
const REG_WAX_SEAL: Rect2 = Rect2(4, 212, 14, 14)
const REG_CROWN_GOLD: Rect2 = Rect2(22, 214, 12, 10)
const REG_SUN_GLYPH: Rect2 = Rect2(38, 214, 10, 10)
const REG_MOON_GLYPH: Rect2 = Rect2(52, 214, 10, 10)
const REG_HOME_BEACON: Rect2 = Rect2(66, 213, 12, 12)
const REG_HEARTH_CREST: Rect2 = Rect2(84, 210, 18, 18)
const REG_RAVEN_CREST: Rect2 = Rect2(106, 210, 18, 18)

const ICON_INDEX: Dictionary = {
	"bag": 0,
	"atlas": 1,
	"quests": 2,
	"path": 3,
	"fruits": 4,
	"world": 5,
	"system": 6,
}

const COL_TEXT: Color = Color("ede8f8")
const COL_TEXT_SOFT: Color = Color("b6aed4")
const COL_TEXT_DIM: Color = Color("7c749e")
const COL_GOLD: Color = Color("e8c468")
const COL_GOLD_HOT: Color = Color("fff0b0")
const COL_TEAL: Color = Color("78f4e6")
const COL_VIOLET: Color = Color("b98cff")
const COL_ROSE: Color = Color("e87094")
const COL_LEAF: Color = Color("7cb96d")
const COL_OUTLINE: Color = Color("0b0716")

static var _sheet: Texture2D = null


static func sheet() -> Texture2D:
	if _sheet == null and ResourceLoader.exists(SHEET_PATH):
		_sheet = load(SHEET_PATH) as Texture2D
	return _sheet


## Pixel-exact 9-slice draw from the shared chrome atlas.
static func draw_nine_slice(canvas: CanvasItem, dest: Rect2, src: Rect2, ml: float, mt: float, mr: float, mb: float, tint: Color = Color.WHITE) -> void:
	var tex: Texture2D = sheet()
	if tex == null or dest.size.x < 2.0 or dest.size.y < 2.0:
		return
	var r: Rect2 = Rect2(dest.position.round(), dest.size.round())
	var l: float = minf(ml, floorf(r.size.x * 0.5))
	var ri: float = minf(mr, floorf(r.size.x * 0.5))
	var t: float = minf(mt, floorf(r.size.y * 0.5))
	var b: float = minf(mb, floorf(r.size.y * 0.5))
	var mw: float = maxf(r.size.x - l - ri, 0.0)
	var mh: float = maxf(r.size.y - t - b, 0.0)
	var smw: float = maxf(src.size.x - ml - mr, 1.0)
	var smh: float = maxf(src.size.y - mt - mb, 1.0)
	var sx: float = src.position.x
	var sy: float = src.position.y
	var dx: float = r.position.x
	var dy: float = r.position.y

	canvas.draw_texture_rect_region(tex, Rect2(dx, dy, l, t), Rect2(sx, sy, ml, mt), tint)
	canvas.draw_texture_rect_region(tex, Rect2(dx + l + mw, dy, ri, t), Rect2(sx + ml + smw, sy, mr, mt), tint)
	canvas.draw_texture_rect_region(tex, Rect2(dx, dy + t + mh, l, b), Rect2(sx, sy + mt + smh, ml, mb), tint)
	canvas.draw_texture_rect_region(tex, Rect2(dx + l + mw, dy + t + mh, ri, b), Rect2(sx + ml + smw, sy + mt + smh, mr, mb), tint)
	if mw > 0.0:
		canvas.draw_texture_rect_region(tex, Rect2(dx + l, dy, mw, t), Rect2(sx + ml, sy, smw, mt), tint)
		canvas.draw_texture_rect_region(tex, Rect2(dx + l, dy + t + mh, mw, b), Rect2(sx + ml, sy + mt + smh, smw, mb), tint)
	if mh > 0.0:
		canvas.draw_texture_rect_region(tex, Rect2(dx, dy + t, l, mh), Rect2(sx, sy + mt, ml, smh), tint)
		canvas.draw_texture_rect_region(tex, Rect2(dx + l + mw, dy + t, ri, mh), Rect2(sx + ml + smw, sy + mt, mr, smh), tint)
	if mw > 0.0 and mh > 0.0:
		canvas.draw_texture_rect_region(tex, Rect2(dx + l, dy + t, mw, mh), Rect2(sx + ml, sy + mt, smw, smh), tint)


## True 1:1 pixel-art tiling inside `dest` (strictly pixel-snapped, zero stretch, clipped cleanly to `dest`).
static func draw_tiled_region(canvas: CanvasItem, dest: Rect2, tile_src: Rect2, tint: Color = Color.WHITE) -> void:
	var tex: Texture2D = sheet()
	if tex == null or dest.size.x <= 0.0 or dest.size.y <= 0.0:
		return
	var r: Rect2 = Rect2(dest.position.round(), dest.size.round())
	var tw: float = maxf(tile_src.size.x, 1.0)
	var th: float = maxf(tile_src.size.y, 1.0)
	var y: float = 0.0
	while y < r.size.y:
		var ch: float = minf(th, r.size.y - y)
		var x: float = 0.0
		while x < r.size.x:
			var cw: float = minf(tw, r.size.x - x)
			canvas.draw_texture_rect_region(
				tex,
				Rect2(r.position.x + x, r.position.y + y, cw, ch),
				Rect2(tile_src.position.x, tile_src.position.y, cw, ch),
				tint
			)
			x += tw
		y += th


static func draw_slate(canvas: CanvasItem, rect: Rect2, alpha: float = 1.0) -> void:
	var r: Rect2 = Rect2(rect.position.round(), rect.size.round())
	# Subtle grounded obsidian drop shadow
	canvas.draw_rect(Rect2(r.position + Vector2(2.0, 3.0), r.size), Color(0.03, 0.02, 0.07, 0.42 * alpha))
	draw_nine_slice(canvas, r, REG_SLATE, 6.0, 6.0, 6.0, 6.0, Color(1, 1, 1, alpha))
	var inner: Rect2 = r.grow(-3.0)
	if inner.size.x > 2.0 and inner.size.y > 2.0:
		draw_tiled_region(canvas, inner, TILE_SLATE, Color(1, 1, 1, alpha))
		# Soft top-edge cool moonlight gradient wash (2px) & bottom depth shadow
		canvas.draw_rect(Rect2(inner.position, Vector2(inner.size.x, 1.0)), Color(0.55, 0.48, 0.85, 0.16 * alpha))
		canvas.draw_rect(Rect2(inner.position.x, inner.end.y - 2.0, inner.size.x, 2.0), Color(0.03, 0.02, 0.07, 0.28 * alpha))


static func draw_inset(canvas: CanvasItem, rect: Rect2, alpha: float = 1.0) -> void:
	var r: Rect2 = Rect2(rect.position.round(), rect.size.round())
	draw_nine_slice(canvas, r, REG_INSET, 5.0, 5.0, 5.0, 5.0, Color(1, 1, 1, alpha))
	var inner: Rect2 = r.grow(-2.0)
	if inner.size.x > 2.0 and inner.size.y > 2.0:
		draw_tiled_region(canvas, inner, TILE_INSET, Color(1, 1, 1, alpha))
		canvas.draw_rect(Rect2(inner.position, Vector2(inner.size.x, 2.0)), Color(0.02, 0.01, 0.06, 0.35 * alpha))


static func draw_cosmos(canvas: CanvasItem, rect: Rect2, alpha: float = 1.0) -> void:
	var r: Rect2 = Rect2(rect.position.round(), rect.size.round())
	draw_nine_slice(canvas, r, REG_INSET, 5.0, 5.0, 5.0, 5.0, Color(1, 1, 1, alpha))
	var inner: Rect2 = r.grow(-2.0)
	if inner.size.x > 2.0 and inner.size.y > 2.0:
		draw_tiled_region(canvas, inner, TILE_COSMOS, Color(1, 1, 1, alpha))
		canvas.draw_rect(Rect2(inner.position, Vector2(inner.size.x, 2.0)), Color(0.02, 0.01, 0.06, 0.40 * alpha))


static func draw_parchment(canvas: CanvasItem, rect: Rect2, alpha: float = 1.0) -> void:
	var r: Rect2 = Rect2(rect.position.round(), rect.size.round())
	canvas.draw_rect(Rect2(r.position + Vector2(2.0, 3.0), r.size), Color(0.03, 0.02, 0.07, 0.42 * alpha))
	draw_nine_slice(canvas, r, REG_PARCHMENT, 6.0, 6.0, 6.0, 6.0, Color(1, 1, 1, alpha))
	var inner: Rect2 = r.grow(-3.0)
	if inner.size.x > 2.0 and inner.size.y > 2.0:
		draw_tiled_region(canvas, inner, TILE_VELLUM, Color(1, 1, 1, alpha))
		canvas.draw_rect(Rect2(inner.position, Vector2(inner.size.x, 1.0)), Color(COL_GOLD.r, COL_GOLD.g, COL_GOLD.b, 0.14 * alpha))
		canvas.draw_rect(Rect2(inner.position.x, inner.end.y - 2.0, inner.size.x, 2.0), Color(0.03, 0.02, 0.07, 0.26 * alpha))


static func draw_gold(canvas: CanvasItem, rect: Rect2, alpha: float = 1.0) -> void:
	var r: Rect2 = Rect2(rect.position.round(), rect.size.round())
	draw_nine_slice(canvas, r, REG_GOLD, 6.0, 6.0, 6.0, 6.0, Color(1, 1, 1, alpha))
	var inner: Rect2 = r.grow(-3.0)
	if inner.size.x > 2.0 and inner.size.y > 2.0:
		draw_tiled_region(canvas, inner, TILE_SLATE, Color(1, 1, 1, alpha))
		canvas.draw_rect(inner, Color(COL_GOLD.r, COL_GOLD.g, COL_GOLD.b, 0.08 * alpha))
		canvas.draw_rect(Rect2(inner.position, Vector2(inner.size.x, 1.0)), Color(COL_GOLD_HOT.r, COL_GOLD_HOT.g, COL_GOLD_HOT.b, 0.24 * alpha))


static func draw_canopy_rail(canvas: CanvasItem, rect: Rect2, alpha: float = 1.0) -> void:
	var r: Rect2 = Rect2(rect.position.round(), rect.size.round())
	draw_tiled_region(canvas, r, TILE_CANOPY, Color(1, 1, 1, alpha))
	# Crisp 1px vertical end caps
	canvas.draw_rect(Rect2(r.position.x, r.position.y, 1.0, r.size.y), Color(COL_OUTLINE, alpha))
	canvas.draw_rect(Rect2(r.end.x - 1.0, r.position.y, 1.0, r.size.y), Color(COL_OUTLINE, alpha))


static func draw_footer_rail(canvas: CanvasItem, rect: Rect2, alpha: float = 1.0) -> void:
	var r: Rect2 = Rect2(rect.position.round(), rect.size.round())
	draw_tiled_region(canvas, r, TILE_FOOTER, Color(1, 1, 1, alpha))
	canvas.draw_rect(Rect2(r.position.x, r.position.y, 1.0, r.size.y), Color(COL_OUTLINE, alpha))
	canvas.draw_rect(Rect2(r.end.x - 1.0, r.position.y, 1.0, r.size.y), Color(COL_OUTLINE, alpha))


static func draw_tab_pill(canvas: CanvasItem, rect: Rect2, active: bool, hover_t: float = 0.0, alpha: float = 1.0) -> void:
	var reg: Rect2 = REG_PILL_ACTIVE if active else REG_PILL_IDLE
	var boost: float = 1.0 + hover_t * 0.14
	draw_nine_slice(canvas, rect, reg, 6.0, 5.0, 6.0, 5.0, Color(boost, boost, boost, alpha))
	if hover_t > 0.05 and not active:
		canvas.draw_rect(Rect2(rect.position.x + 4.0, rect.position.y + 1.0, rect.size.x - 8.0, 1.0), Color(COL_TEAL.r, COL_TEAL.g, COL_TEAL.b, 0.60 * hover_t * alpha))


static func draw_moss_niche(canvas: CanvasItem, rect: Rect2, selected: bool, hover: bool, accent: Color, alpha: float = 1.0) -> void:
	draw_nine_slice(canvas, rect, REG_MOSS_NICHE, 6.0, 6.0, 6.0, 6.0, Color(1, 1, 1, alpha))
	if selected:
		var r: Rect2 = Rect2(rect.position.round(), rect.size.round())
		canvas.draw_rect(Rect2(r.position + Vector2(1, 1), Vector2(r.size.x - 2, 1)), Color(accent.r, accent.g, accent.b, 0.95 * alpha))
		canvas.draw_rect(Rect2(r.position + Vector2(1, r.size.y - 2), Vector2(r.size.x - 2, 1)), Color(accent.r, accent.g, accent.b, 0.72 * alpha))
		canvas.draw_rect(Rect2(r.position + Vector2(1, 1), Vector2(1, r.size.y - 2)), Color(accent.r, accent.g, accent.b, 0.80 * alpha))
		canvas.draw_rect(Rect2(r.position + Vector2(r.size.x - 2, 1), Vector2(1, r.size.y - 2)), Color(accent.r, accent.g, accent.b, 0.80 * alpha))
	elif hover:
		var r2: Rect2 = Rect2(rect.position.round(), rect.size.round())
		canvas.draw_rect(Rect2(r2.position + Vector2(2, 1), Vector2(r2.size.x - 4, 1)), Color(COL_GOLD.r, COL_GOLD.g, COL_GOLD.b, 0.70 * alpha))


static func draw_icon(canvas: CanvasItem, kind: String, pos: Vector2, lit: bool, alpha: float = 1.0) -> void:
	var tex: Texture2D = sheet()
	if tex == null:
		return
	var idx: int = int(ICON_INDEX.get(kind, 0))
	var reg: Rect2 = Rect2(4.0 + float(idx) * 16.0, 96.0 if lit else 80.0, 12.0, 12.0)
	canvas.draw_texture_rect_region(tex, Rect2(pos.round(), Vector2(12, 12)), reg, Color(1, 1, 1, alpha))


static func draw_bloom_slider(canvas: CanvasItem, center_x: float, y: float, alpha: float = 1.0) -> void:
	var tex: Texture2D = sheet()
	if tex == null:
		return
	var pos: Vector2 = Vector2(roundf(center_x - 14.0), roundf(y))
	canvas.draw_texture_rect_region(tex, Rect2(pos, Vector2(28, 8)), REG_BLOOM, Color(1, 1, 1, alpha))


static func draw_badge(canvas: CanvasItem, pos: Vector2, time: float, alpha: float = 1.0) -> void:
	var tex: Texture2D = sheet()
	if tex == null:
		return
	var pulse: float = 0.82 + 0.18 * sin(time * 5.2)
	canvas.draw_texture_rect_region(tex, Rect2(pos.round(), Vector2(9, 9)), REG_BADGE, Color(1.0 + 0.25 * pulse, 1.0 + 0.15 * pulse, 1.0, alpha * pulse))


static func draw_lock(canvas: CanvasItem, pos: Vector2, alpha: float = 1.0) -> void:
	var tex: Texture2D = sheet()
	if tex == null:
		return
	canvas.draw_texture_rect_region(tex, Rect2(pos.round(), Vector2(12, 12)), REG_LOCK, Color(1, 1, 1, alpha))


static func draw_wax_seal(canvas: CanvasItem, pos: Vector2, alpha: float = 1.0, tint: Color = Color.WHITE) -> void:
	var tex: Texture2D = sheet()
	if tex == null:
		return
	canvas.draw_texture_rect_region(tex, Rect2(pos.round(), Vector2(14, 14)), REG_WAX_SEAL, Color(tint.r, tint.g, tint.b, tint.a * alpha))


static func draw_crown(canvas: CanvasItem, pos: Vector2, alpha: float = 1.0) -> void:
	var tex: Texture2D = sheet()
	if tex == null:
		return
	canvas.draw_texture_rect_region(tex, Rect2(pos.round(), Vector2(12, 10)), REG_CROWN_GOLD, Color(1, 1, 1, alpha))


static func draw_day_phase_glyph(canvas: CanvasItem, pos: Vector2, is_night: bool, alpha: float = 1.0) -> void:
	var tex: Texture2D = sheet()
	if tex == null:
		return
	var reg: Rect2 = REG_MOON_GLYPH if is_night else REG_SUN_GLYPH
	canvas.draw_texture_rect_region(tex, Rect2(pos.round(), Vector2(10, 10)), reg, Color(1, 1, 1, alpha))


static func draw_home_beacon(canvas: CanvasItem, pos: Vector2, alpha: float = 1.0) -> void:
	var tex: Texture2D = sheet()
	if tex == null:
		return
	canvas.draw_texture_rect_region(tex, Rect2(pos.round(), Vector2(12, 12)), REG_HOME_BEACON, Color(1, 1, 1, alpha))


static func draw_hearth_crest(canvas: CanvasItem, pos: Vector2, alpha: float = 1.0) -> void:
	var tex: Texture2D = sheet()
	if tex == null:
		return
	canvas.draw_texture_rect_region(tex, Rect2(pos.round(), Vector2(18, 18)), REG_HEARTH_CREST, Color(1, 1, 1, alpha))


static func draw_raven_crest(canvas: CanvasItem, pos: Vector2, alpha: float = 1.0) -> void:
	var tex: Texture2D = sheet()
	if tex == null:
		return
	canvas.draw_texture_rect_region(tex, Rect2(pos.round(), Vector2(18, 18)), REG_RAVEN_CREST, Color(1, 1, 1, alpha))


static func draw_divider(canvas: CanvasItem, center_x: float, y: float, width: float, alpha: float = 1.0) -> void:
	var r_y: float = roundf(y)
	var half: float = roundf(width * 0.5)
	canvas.draw_rect(Rect2(roundf(center_x - half), r_y + 3.0, width, 1.0), Color("5b4938", 0.72 * alpha))
	var tex: Texture2D = sheet()
	if tex != null:
		canvas.draw_texture_rect_region(tex, Rect2(roundf(center_x - 24.0), r_y, 48.0, 7.0), REG_DIVIDER, Color(1, 1, 1, alpha))


static func draw_corners(canvas: CanvasItem, rect: Rect2, alpha: float = 1.0) -> void:
	var tex: Texture2D = sheet()
	if tex == null:
		return
	var r: Rect2 = Rect2(rect.position.round(), rect.size.round())
	var tint: Color = Color(1, 1, 1, alpha)
	canvas.draw_texture_rect_region(tex, Rect2(r.position, Vector2(14, 14)), REG_CORNER_NW, tint)
	canvas.draw_texture_rect_region(tex, Rect2(Vector2(r.end.x - 14.0, r.position.y), Vector2(14, 14)), REG_CORNER_NE, tint)
	canvas.draw_texture_rect_region(tex, Rect2(Vector2(r.position.x, r.end.y - 14.0), Vector2(14, 14)), REG_CORNER_SW, tint)
	canvas.draw_texture_rect_region(tex, Rect2(Vector2(r.end.x - 14.0, r.end.y - 14.0), Vector2(14, 14)), REG_CORNER_SE, tint)


## Sleek pixel-crisp progress tube with glowing tip highlight
static func draw_bar(canvas: CanvasItem, rect: Rect2, ratio: float, fill_col: Color, alpha: float = 1.0) -> void:
	var r: Rect2 = Rect2(rect.position.round(), rect.size.round())
	canvas.draw_rect(r, Color(COL_OUTLINE.r, COL_OUTLINE.g, COL_OUTLINE.b, alpha))
	var inner: Rect2 = r.grow(-1.0)
	canvas.draw_rect(inner, Color("141026", alpha))
	var fw: float = roundf(inner.size.x * clampf(ratio, 0.0, 1.0))
	if fw >= 1.0:
		canvas.draw_rect(Rect2(inner.position, Vector2(fw, inner.size.y)), Color(fill_col.r, fill_col.g, fill_col.b, alpha))
		canvas.draw_rect(Rect2(inner.position, Vector2(fw, 1.0)), Color(fill_col.lightened(0.32).r, fill_col.lightened(0.32).g, fill_col.lightened(0.32).b, alpha))
		if fw >= 3.0:
			canvas.draw_rect(Rect2(Vector2(inner.position.x + fw - 1.0, inner.position.y), Vector2(1.0, inner.size.y)), Color(1.0, 1.0, 1.0, 0.65 * alpha))


## Crisp top-edge hover shimmer streak
static func draw_shimmer(canvas: CanvasItem, rect: Rect2, time: float, col: Color, alpha: float = 1.0) -> void:
	var span: float = maxf(rect.size.x - 16.0, 8.0)
	var pos: float = fposmod(time * 0.75, 1.0) * span
	var sx: float = roundf(rect.position.x + 6.0 + pos)
	var sy: float = roundf(rect.position.y + 1.0)
	canvas.draw_rect(Rect2(sx, sy, 8.0, 1.0), Color(col.r, col.g, col.b, 0.75 * alpha))


## Gentle ambient bioluminescent motes drifting softly inside a showcase panel
static func draw_panel_spores(canvas: CanvasItem, rect: Rect2, time: float, seed_val: int, tint: Color = COL_TEAL, count: int = 8, alpha: float = 1.0) -> void:
	if rect.size.x < 24.0 or rect.size.y < 24.0:
		return
	var inner: Rect2 = rect.grow(-6.0)
	for i: int in count:
		var fi: float = float(i + seed_val * 13)
		var rx: float = fposmod(sin(fi * 12.9898) * 43758.5453, 1.0)
		var ry: float = fposmod(sin((fi + 7.13) * 78.233) * 23421.631, 1.0)
		var speed: float = 4.0 + fposmod(fi * 1.7, 5.0)
		var py: float = inner.end.y - fposmod(ry * inner.size.y + time * speed, inner.size.y)
		var px: float = inner.position.x + clampf(rx * inner.size.x + sin(time * 0.9 + fi) * 4.0, 1.0, inner.size.x - 2.0)
		var blink: float = 0.25 + 0.75 * pow(0.5 + 0.5 * sin(time * 2.2 + fi * 2.7), 2.0)
		var c: Color = tint if (i % 3 != 0) else COL_GOLD_HOT
		canvas.draw_rect(Rect2(roundf(px), roundf(py), 1.0, 1.0), Color(c.r, c.g, c.b, 0.45 * blink * alpha))


## Renders expanding pixel shockwave rings + rising celebration sparks from `bursts` array:
## Each entry: {"pos": Vector2, "age": float, "max_age": float, "col": Color}
static func draw_burst_rings(canvas: CanvasItem, bursts: Array[Dictionary]) -> void:
	for b: Dictionary in bursts:
		var age: float = float(b.get("age", 0.0))
		var max_age: float = maxf(float(b.get("max_age", 0.55)), 0.05)
		var u: float = clampf(age / max_age, 0.0, 1.0)
		var ease_u: float = 1.0 - pow(1.0 - u, 3.0)
		var fade: float = (1.0 - u) * (1.0 - u * 0.35)
		var pos: Vector2 = (b.get("pos", Vector2.ZERO) as Vector2).round()
		var col: Color = b.get("col", COL_GOLD_HOT) as Color
		var rad: float = 4.0 + ease_u * 26.0
		var steps: int = 20
		for s: int in steps:
			var ang: float = float(s) * TAU / float(steps) + u * 0.4
			var pt: Vector2 = (pos + Vector2(cos(ang), sin(ang)) * rad).round()
			canvas.draw_rect(Rect2(pt, Vector2.ONE), Color(col.r, col.g, col.b, 0.9 * fade))
		# 8 rising celebratory sparks
		for k: int in 8:
			var ka: float = float(k) * TAU / 8.0 + 0.3
			var dist: float = 3.0 + ease_u * (14.0 + float(k % 3) * 6.0)
			var sp: Vector2 = (pos + Vector2(cos(ka) * dist, sin(ka) * dist - ease_u * 9.0)).round()
			var sc: Color = COL_GOLD_HOT if k % 2 == 0 else col
			canvas.draw_rect(Rect2(sp, Vector2(2.0 if u < 0.45 else 1.0, 2.0 if u < 0.45 else 1.0)), Color(sc.r, sc.g, sc.b, fade))


static func draw_text(canvas: CanvasItem, text: String, pos: Vector2, color: Color, alpha: float = 1.0, shadow: bool = true) -> void:
	var ip: Vector2i = Vector2i(int(roundf(pos.x)), int(roundf(pos.y)))
	if shadow:
		PixelText.draw(canvas, text, ip + Vector2i(0, 1), Color(COL_OUTLINE.r, COL_OUTLINE.g, COL_OUTLINE.b, 0.85 * alpha))
	PixelText.draw(canvas, text, ip, Color(color.r, color.g, color.b, color.a * alpha))


static func draw_text_centered(canvas: CanvasItem, text: String, center_x: float, y: float, color: Color, alpha: float = 1.0, shadow: bool = true) -> void:
	var tw: float = float(PixelText.width(text))
	draw_text(canvas, text, Vector2(roundf(center_x - tw * 0.5), roundf(y)), color, alpha, shadow)


static func fit_text(text: String, max_px: float) -> String:
	var clean: String = text.strip_edges().to_upper()
	if float(PixelText.width(clean)) <= max_px:
		return clean
	var out: String = clean
	while out.length() > 2 and float(PixelText.width(out + "..")) > max_px:
		out = out.left(out.length() - 1)
	return out.strip_edges() + ".."


static func wrap_lines(text: String, max_px: float) -> Array[String]:
	var lines: Array[String] = []
	var cur: String = ""
	for word: String in text.to_upper().split(" ", false):
		var cand: String = word if cur.is_empty() else (cur + " " + word)
		if not cur.is_empty() and float(PixelText.width(cand)) > max_px:
			lines.append(cur)
			cur = word
		else:
			cur = cand
	if not cur.is_empty():
		lines.append(cur)
	return lines


## Heading label + delicate gradient brass/accent divider hairline
static func draw_section_header(canvas: CanvasItem, pos: Vector2, width: float, title: String, accent: Color = COL_GOLD, alpha: float = 1.0) -> void:
	var p: Vector2 = pos.round()
	draw_text(canvas, title, p, accent, alpha)
	var tw: float = float(PixelText.width(title))
	var lx: float = p.x + tw + 6.0
	var lw: float = maxf(width - tw - 6.0, 0.0)
	if lw >= 4.0:
		canvas.draw_rect(Rect2(lx, p.y + 4.0, lw, 1.0), Color(accent.r, accent.g, accent.b, 0.28 * alpha))
		canvas.draw_rect(Rect2(lx, p.y + 4.0, minf(lw, 18.0), 1.0), Color(accent.r, accent.g, accent.b, 0.58 * alpha))


## Small status badge pill (ERLERNT, BEREIT!, HOST, AKTIV, ...)
static func draw_chip(canvas: CanvasItem, rect: Rect2, label: String, fill: Color, rim: Color, text_col: Color, alpha: float = 1.0) -> void:
	var r: Rect2 = Rect2(rect.position.round(), rect.size.round())
	canvas.draw_rect(r, Color(COL_OUTLINE.r, COL_OUTLINE.g, COL_OUTLINE.b, 0.95 * alpha))
	canvas.draw_rect(r.grow(-1.0), Color(fill.r, fill.g, fill.b, 0.95 * alpha))
	canvas.draw_rect(Rect2(r.position.x + 1.0, r.position.y + 1.0, r.size.x - 2.0, 1.0), Color(rim.r, rim.g, rim.b, 0.85 * alpha))
	draw_text_centered(canvas, label, r.get_center().x, r.position.y + floorf((r.size.y - 7.0) * 0.5), text_col, alpha)


## Tactile obsidian/accent Feldcodex action button
static func draw_button(canvas: CanvasItem, rect: Rect2, label: String, hovered: bool = false, primary: bool = false, risky: bool = false, disabled: bool = false, alpha: float = 1.0) -> void:
	var r: Rect2 = Rect2(rect.position.round(), rect.size.round())
	if primary and not disabled:
		draw_gold(canvas, r, alpha)
		if hovered:
			canvas.draw_rect(r.grow(-2.0), Color(COL_GOLD.r, COL_GOLD.g, COL_GOLD.b, 0.16 * alpha))
		draw_text_centered(canvas, label, r.get_center().x, r.position.y + floorf((r.size.y - 7.0) * 0.5), COL_GOLD_HOT if hovered else COL_GOLD, alpha)
		return
	var bg: Color = Color("161224")
	var rim: Color = Color("433763")
	var txt: Color = COL_TEXT_SOFT
	if disabled:
		bg = Color("110e1c")
		rim = Color("28213d")
		txt = COL_TEXT_DIM
	elif risky:
		bg = Color("3c1828") if hovered else Color("28121d")
		rim = Color("e06678") if hovered else Color("8b3648")
		txt = Color("ffd6dc") if hovered else Color("e08e9a")
	elif hovered:
		bg = Color("241d3c")
		rim = COL_TEAL
		txt = COL_TEXT
	canvas.draw_rect(r, Color(COL_OUTLINE.r, COL_OUTLINE.g, COL_OUTLINE.b, 0.95 * alpha))
	canvas.draw_rect(r.grow(-1.0), Color(bg.r, bg.g, bg.b, 0.96 * alpha))
	canvas.draw_rect(Rect2(r.position.x + 1.0, r.position.y + 1.0, r.size.x - 2.0, 1.0), Color(rim.r, rim.g, rim.b, 0.90 * alpha))
	canvas.draw_rect(Rect2(r.position.x + 1.0, r.end.y - 2.0, r.size.x - 2.0, 1.0), Color(rim.darkened(0.45).r, rim.darkened(0.45).g, rim.darkened(0.45).b, 0.75 * alpha))
	draw_text_centered(canvas, label, r.get_center().x, r.position.y + floorf((r.size.y - 7.0) * 0.5), txt, alpha)


## Crisp pixel toggle pill switch (AN / AUS)
static func draw_toggle(canvas: CanvasItem, rect: Rect2, on: bool, hovered: bool = false, alpha: float = 1.0) -> void:
	var r: Rect2 = Rect2(rect.position.round(), rect.size.round())
	var fill: Color = Color("184644") if on else Color("171326")
	var rim: Color = COL_TEAL if (on or hovered) else Color("3b3159")
	canvas.draw_rect(r, Color(COL_OUTLINE.r, COL_OUTLINE.g, COL_OUTLINE.b, 0.95 * alpha))
	canvas.draw_rect(r.grow(-1.0), Color(fill.r, fill.g, fill.b, 0.95 * alpha))
	canvas.draw_rect(Rect2(r.position.x + 1.0, r.position.y + 1.0, r.size.x - 2.0, 1.0), Color(rim.r, rim.g, rim.b, 0.85 * alpha))
	var knob_w: float = 9.0
	var knob_x: float = r.end.x - knob_w - 2.0 if on else r.position.x + 2.0
	var knob: Rect2 = Rect2(knob_x, r.position.y + 2.0, knob_w, r.size.y - 4.0)
	canvas.draw_rect(knob, Color(COL_TEAL if on else Color("6f6690"), alpha))
	canvas.draw_rect(Rect2(knob.position, Vector2(knob.size.x, 1.0)), Color(Color("e6fffb") if on else Color("9e95be"), alpha))
	var lbl: String = "AN" if on else "AUS"
	var track_l: float = (r.position.x + 1.0) if on else (knob_x + knob_w + 1.0)
	var track_r: float = (knob_x - 1.0) if on else (r.end.x - 1.0)
	var text_cx: float = (track_l + track_r) * 0.5
	draw_text_centered(canvas, lbl, text_cx, r.position.y + floorf((r.size.y - 7.0) * 0.5), COL_TEAL if on else COL_TEXT_DIM, alpha)


## Pixel-crisp interactive slider with luminous fill and brass/teal handle
static func draw_slider(canvas: CanvasItem, rect: Rect2, ratio: float, accent: Color = COL_GOLD, hovered: bool = false, alpha: float = 1.0) -> void:
	var r: Rect2 = Rect2(rect.position.round(), rect.size.round())
	var cy: float = roundf(r.get_center().y)
	var track: Rect2 = Rect2(r.position.x, cy - 2.0, r.size.x, 5.0)
	draw_bar(canvas, track, ratio, accent, alpha)
	var kx: float = roundf(lerpf(r.position.x + 3.0, r.end.x - 4.0, clampf(ratio, 0.0, 1.0)))
	var knob: Rect2 = Rect2(kx - 3.0, cy - 4.0, 7.0, 9.0)
	canvas.draw_rect(knob, Color(COL_OUTLINE.r, COL_OUTLINE.g, COL_OUTLINE.b, alpha))
	canvas.draw_rect(knob.grow(-1.0), Color(COL_GOLD_HOT if hovered else accent, alpha))
	canvas.draw_rect(Rect2(knob.position + Vector2(1.0, 1.0), Vector2(knob.size.x - 2.0, 1.0)), Color(1.0, 1.0, 1.0, 0.75 * alpha))


## Crisp obsidian & brass keycap badge (lights up in teal/gold when `lit` is true), returns rendered pixel width
static func draw_keycap(canvas: CanvasItem, pos: Vector2, label: String, alpha: float = 1.0, lit: bool = false) -> float:
	var w: float = maxf(float(PixelText.width(label)) + 8.0, 14.0)
	var r: Rect2 = Rect2(pos.round(), Vector2(w, 13.0))
	canvas.draw_rect(r, Color(COL_OUTLINE.r, COL_OUTLINE.g, COL_OUTLINE.b, 0.95 * alpha))
	canvas.draw_rect(r.grow(-1.0), Color("244a4c" if lit else "1e1830", 0.96 * alpha))
	canvas.draw_rect(Rect2(r.position.x + 1.0, r.position.y + 1.0, r.size.x - 2.0, 1.0), Color(COL_TEAL if lit else Color("5a4c7c"), 0.95 * alpha))
	canvas.draw_rect(Rect2(r.position.x + 1.0, r.end.y - 2.0, r.size.x - 2.0, 1.0), Color("110d1e", 0.9 * alpha))
	draw_text_centered(canvas, label, r.get_center().x, r.position.y + 3.0, COL_GOLD_HOT if lit else COL_GOLD, alpha)
	return w
