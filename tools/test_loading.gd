extends Node

func _ready() -> void:
	var screen: LoadingScreen = LoadingScreen.new()
	add_child(screen)
	screen.set_process(false)
	assert(screen.companions.size() == 2)
	assert(screen.companions[0] != screen.companions[1])
	screen.advance(20.0)
	assert(screen.chase < 0.0, "Long loading must loop without a spider")
	screen.complete()
	screen.advance(0.01)
	assert(screen.chase == 0.0)
	screen.advance(LoadingScreen.CHASE_LENGTH)
	assert(screen.done)
	var fast: LoadingScreen = LoadingScreen.new()
	add_child(fast)
	fast.set_process(false)
	fast.complete()
	fast.advance(0.5)
	assert(fast.chase < 0.0, "Fast loads still show both entrances")
	fast.advance(LoadingScreen.ENTRANCE_END)
	assert(fast.chase == 0.0)
	print("PASS loading: unique companions, real readiness, short and long loads, exit")
	get_tree().quit()
